# Install Jenkins with Docker CLI support in order to run Playwright tests in a Jenkins pipeline. 
# This Dockerfile extends the official Jenkins image and adds the Docker CLI.
FROM jenkins/jenkins:lts

USER root

# Install Docker CLI inside Jenkins container, otherwise Jenkins won't be able to execute docker build and docker run commands against the host Docker daemon (via socket).
RUN apt-get update && \
    apt-get install -y docker.io && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

USER jenkins

## Host Docker daemon runs on your machine.
## Jenkins container connects to host Docker via -v /var/run/docker.sock:/var/run/docker.sock.
## Pipeline commands (docker build, docker run) execute inside the Jenkins container but actually use the host Docker daemon.
## Playwright container is built and run dynamically during the pipeline.
## Test reports are written to a volume mapped to the Jenkins workspace so Jenkins can archive them.